generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id         String    @id @default(cuid())
  authorName String
  rawInput   String
  title      String
  summary    String
  content    String
  tags       String
  advice     String?
  likes      Int       @default(0)
  createdAt  DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  fromName  String
  toName    String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
