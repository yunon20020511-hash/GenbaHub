# ============================================================
# Genba Hub — 環境変数設定例
# このファイルをコピーして .env.local を作成してください
# cp .env.local.example .env.local
# ============================================================

# ----------------------------------------------------------------
# データベース接続 (Supabase / PostgreSQL)
# ----------------------------------------------------------------
# Supabase: プロジェクト設定 > Database > Connection String > Transaction Pooler
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase: プロジェクト設定 > Database > Connection String > Direct Connection
# マイグレーション実行時に使用（prisma db push / migrate）
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.db.supabase.co:5432/postgres"

# ----------------------------------------------------------------
# NextAuth.js
# ----------------------------------------------------------------
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_nextauth_secret_here_32chars_minimum

# 本番環境では実際のURLを設定（ローカル開発では省略可）
# NEXTAUTH_URL=https://your-domain.com

# ----------------------------------------------------------------
# Groq AI API (https://console.groq.com/keys — 無料枠あり)
# ----------------------------------------------------------------
# 未設定の場合はモックレスポンスで動作します
GROQ_API_KEY=your_groq_api_key_here
